<section class="max-w-4xl mx-auto px-6 py-28">
  <h1 class="font-serif text-4xl md:text-5xl font-medium text-[var(--color-mirloz-cream)] mb-8">
    {{ 'general.search.title' | t }}
  </h1>

  <form action="{{ routes.search_url }}" method="get" class="flex gap-3 mb-12">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      class="flex-1 px-5 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
    >
    <button
      type="submit"
      class="bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-8 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer"
    >
      {{ 'general.search.button' | t }}
    </button>
  </form>

  {% if search.performed %}
    {% if search.results_count > 0 %}
      <p class="font-mono text-xs text-[var(--color-mirloz-muted)] mb-8">
        {{ 'general.search.results_for' | t: terms: search.terms }} ({{ search.results_count }})
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for item in search.results %}
          {% case item.object_type %}
            {% when 'product' %}
              <a href="{{ item.url }}" class="group bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] hover:border-[var(--color-mirloz-gold)]/40 rounded-lg overflow-hidden transition-all no-underline flex flex-col">
                <div class="aspect-square bg-black/20 overflow-hidden">
                  {% if item.featured_image %}
                    <img src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title }}" class="w-full h-full object-cover" loading="lazy">
                  {% endif %}
                </div>
                <div class="p-4">
                  <p class="font-mono text-[9px] text-[var(--color-mirloz-gold)] mb-1">Producto</p>
                  <h3 class="font-serif text-lg text-[var(--color-mirloz-cream)]">{{ item.title }}</h3>
                  <p class="font-mono text-sm text-[var(--color-mirloz-gold)] mt-2">{{ item.price | money }}</p>
                </div>
              </a>
            {% when 'article' %}
              <a href="{{ item.url }}" class="group bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] hover:border-[var(--color-mirloz-gold)]/40 rounded-lg overflow-hidden transition-all no-underline">
                <div class="p-4">
                  <p class="font-mono text-[9px] text-[var(--color-mirloz-gold)] mb-1">Artículo</p>
                  <h3 class="font-serif text-lg text-[var(--color-mirloz-cream)] mb-2">{{ item.title }}</h3>
                  <p class="text-xs text-[var(--color-mirloz-muted)] font-sans">{{ item.excerpt_or_content | strip_html | truncatewords: 15 }}</p>
                </div>
              </a>
            {% when 'page' %}
              <a href="{{ item.url }}" class="group bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] hover:border-[var(--color-mirloz-gold)]/40 rounded-lg overflow-hidden transition-all no-underline">
                <div class="p-4">
                  <p class="font-mono text-[9px] text-[var(--color-mirloz-gold)] mb-1">Página</p>
                  <h3 class="font-serif text-lg text-[var(--color-mirloz-cream)]">{{ item.title }}</h3>
                </div>
              </a>
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <p class="text-center py-20 font-mono text-sm text-[var(--color-mirloz-muted)]">
        {{ 'general.search.no_results' | t: terms: search.terms }}
      </p>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Búsqueda",
  "settings": [],
  "presets": [
    {
      "name": "Búsqueda Principal"
    }
  ]
}
{% endschema %}
