<section id="BlogSection-{{ section.id }}" class="w-full py-24 relative z-10 bg-[var(--color-mirloz-dark)]">
  {% render 'wave-divider', fill_color: 'var(--color-mirloz-surface)', opacity: '1' %}
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-mirloz-gold)] mb-4">
          {{ section.settings.badge_text }}
        </p>
        <h2 class="font-serif text-4xl md:text-5xl font-medium text-[var(--color-mirloz-cream)] leading-tight">
          {{ section.settings.heading }}
        </h2>
      </div>
      {% if section.settings.button_link != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="font-mono text-xs text-[var(--color-mirloz-gold)] hover:text-[var(--color-mirloz-gold-light)] flex items-center gap-1.5 no-underline border border-[var(--color-mirloz-border)] hover:border-[var(--color-mirloz-gold)] px-6 py-3 transition-colors rounded-sm"
        >
          {{ section.settings.button_text }}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      {% endif %}
    </div>

    <!-- Blog Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {%- assign selected_blog = blogs[section.settings.blog_id] -%}
      {%- if selected_blog != blank and selected_blog.articles_count > 0 -%}
        
        {%- for article in selected_blog.articles limit: section.settings.post_limit -%}
          <article class="group bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] hover:border-[var(--color-mirloz-gold)]/40 rounded-lg overflow-hidden transition-all duration-300 flex flex-col justify-between">
            <div>
              <!-- Article Image -->
              <div class="relative aspect-video bg-black/20 overflow-hidden border-b border-[var(--color-mirloz-border)]">
                {% if article.image %}
                  <img
                    src="{{ article.image.src | image_url: width: 600 }}"
                    alt="{{ article.title }}"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                {% else %}
                  <div class="w-full h-full flex items-center justify-center p-8 bg-black/10">
                    <span class="text-4xl opacity-20">✏️</span>
                  </div>
                {% endif %}
                
                <!-- Date badge overlay -->
                <div class="absolute bottom-4 left-4 bg-[var(--color-mirloz-dark)]/90 backdrop-blur-sm text-[var(--color-mirloz-muted)] font-mono text-[9px] tracking-[0.1em] uppercase px-3 py-1.5 border border-[var(--color-mirloz-border)]">
                  {{ article.published_at | date: "%d %b %Y" }}
                </div>
              </div>

              <!-- Article Content -->
              <div class="p-6">
                {% if article.tags.size > 0 %}
                  <span class="font-mono text-[9px] tracking-[0.15em] text-[var(--color-mirloz-gold)] uppercase block mb-2">
                    {{ article.tags[0] }}
                  </span>
                {% endif %}
                <h3 class="font-serif text-xl md:text-2xl font-medium text-[var(--color-mirloz-cream)] mb-3 group-hover:text-[var(--color-mirloz-gold)] transition-colors line-clamp-2">
                  <a href="{{ article.url }}" class="no-underline text-inherit">{{ article.title }}</a>
                </h3>
                <p class="text-sm text-[var(--color-mirloz-muted)] leading-relaxed font-sans mb-4 line-clamp-3">
                  {{ article.excerpt_or_content | strip_html | truncatewords: 25 }}
                </p>
              </div>
            </div>

            <!-- Read More Link -->
            <div class="p-6 pt-0">
              <a
                href="{{ article.url }}"
                class="inline-flex items-center gap-1.5 font-mono text-xs text-[var(--color-mirloz-gold)] hover:text-[var(--color-mirloz-gold-light)] transition-colors no-underline font-bold"
              >
                Seguir leyendo
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}

      {%- else -%}
        <!-- Fallback/Mockup items if no blog posts are found in selected blog -->
        {%- for i in (1..3) -%}
          <article class="group bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] rounded-lg overflow-hidden flex flex-col justify-between opacity-85">
            <div>
              <div class="relative aspect-video bg-black/30 overflow-hidden flex items-center justify-center border-b border-[var(--color-mirloz-border)]">
                <span class="text-4xl opacity-30">📰</span>
              </div>
              <div class="p-6">
                <span class="font-mono text-[9px] tracking-[0.15em] text-[var(--color-mirloz-gold)] uppercase block mb-2">Divulgación</span>
                <h3 class="font-serif text-xl font-medium text-[var(--color-mirloz-cream)] mb-3">La Reacción de Maillard en el Tueste</h3>
                <p class="text-sm text-[var(--color-mirloz-muted)] leading-relaxed font-sans mb-4">
                  Un vistazo a cómo el calor altera los azúcares y proteínas del café verde, generando los más de 800 compuestos volátiles de aroma.
                </p>
              </div>
            </div>
            <div class="p-6 pt-0">
              <span class="font-mono text-xs text-[var(--color-mirloz-muted)]">[Artículo de Muestra]</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Mirloz Blog Feed",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Bitácora"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Café, Ciencia y Cultura"
    },
    {
      "type": "blog",
      "id": "blog_id",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 3,
      "max": 9,
      "step": 3,
      "label": "Post Limit",
      "default": 3
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Header Link Text",
      "default": "Ver Todos los Artículos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Header Link URL"
    }
  ],
  "presets": [
    {
      "name": "Mirloz Blog Feed",
      "category": "Blog"
    }
  ]
}
{% endschema %}
