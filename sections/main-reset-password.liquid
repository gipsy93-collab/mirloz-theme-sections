<section class="max-w-md mx-auto px-6 py-28">
  <h1 class="font-serif text-3xl md:text-4xl font-medium text-[var(--color-mirloz-cream)] mb-8 text-center">
    {{ 'general.customer.reset_password.title' | t }}
  </h1>

  {% form 'recover_customer_password' %}
    {{ form.errors | default_errors }}

    <div class="space-y-4">
      <input
        type="email"
        name="email"
        placeholder="{{ 'general.customer.reset_password.email' | t }}"
        required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
      >
      <button
        type="submit"
        class="w-full bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-8 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer"
      >
        {{ 'general.customer.reset_password.submit' | t }}
      </button>
    </div>

    <div class="text-center mt-6">
      <a href="{{ routes.account_login_url }}" class="font-mono text-xs text-[var(--color-mirloz-muted)] hover:text-[var(--color-mirloz-cream)] no-underline">
        {{ 'general.customer.reset_password.cancel' | t }}
      </a>
    </div>
  {% endform %}
</section>

{% schema %}
{
  "name": "Restablecer Contraseña",
  "settings": [],
  "presets": [
    {
      "name": "Restablecer Contraseña"
    }
  ]
}
{% endschema %}
