<section class="max-w-3xl mx-auto px-6 py-28">
  <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-mirloz-gold)] mb-4">
    {{ article.published_at | date: "%d de %B, %Y" }}
  </p>
  <h1 class="font-serif text-4xl md:text-5xl font-medium text-[var(--color-mirloz-cream)] mb-8 leading-[1.1]">
    {{ article.title }}
  </h1>

  {% if article.image %}
    <div class="aspect-video rounded-lg overflow-hidden border border-[var(--color-mirloz-border)] mb-10">
      <img
        src="{{ article.image.src | image_url: width: 1200 }}"
        alt="{{ article.title }}"
        class="w-full h-full object-cover"
        loading="eager"
      >
    </div>
  {% endif %}

  <div class="text-[var(--color-mirloz-muted)] leading-relaxed font-sans text-base prose-invert">
    {{ article.content }}
  </div>

  <div class="mt-12 pt-8 border-t border-[var(--color-mirloz-border)]">
    <a href="{{ blog.url }}" class="inline-flex items-center gap-2 font-mono text-xs text-[var(--color-mirloz-gold)] hover:text-[var(--color-mirloz-gold-light)] transition-colors no-underline">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
      {{ 'general.blog.back_to_blog' | t }}
    </a>
  </div>

  {% if article.comments_enabled? %}
    <div class="mt-12 pt-8 border-t border-[var(--color-mirloz-border)]">
      {% if article.comments_count > 0 %}
        <h2 class="font-serif text-2xl text-[var(--color-mirloz-cream)] mb-6">Comentarios ({{ article.comments_count }})</h2>
        <div class="space-y-6">
          {% for comment in article.comments %}
            <div class="bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] rounded-lg p-6">
              <p class="font-mono text-[10px] text-[var(--color-mirloz-muted)] mb-2">{{ comment.author }} &mdash; {{ comment.created_at | date: "%d/%m/%Y" }}</p>
              <p class="text-sm text-[var(--color-mirloz-cream)] font-sans leading-relaxed">{{ comment.content }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% form 'new_comment', article %}
        <h3 class="font-serif text-xl text-[var(--color-mirloz-cream)] mb-4 mt-10">Deja un comentario</h3>
        {% if form.errors %}
          <p class="text-red-400 font-mono text-xs mb-4">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="space-y-4">
          <input type="text" name="comment[author]" placeholder="Nombre" required
            class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
          <input type="email" name="comment[email]" placeholder="Correo electrónico" required
            class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
          <textarea name="comment[body]" rows="4" placeholder="Tu comentario..." required
            class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none resize-y"></textarea>
          <button type="submit"
            class="bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-8 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer">
            Enviar comentario
          </button>
        </div>
      {% endform %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Artículo",
  "settings": [],
  "presets": [
    {
      "name": "Artículo Principal"
    }
  ]
}
{% endschema %}
