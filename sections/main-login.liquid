<section class="max-w-md mx-auto px-6 py-28">
  <h1 class="font-serif text-3xl md:text-4xl font-medium text-[var(--color-mirloz-cream)] mb-8 text-center">
    {{ 'general.customer.login.title' | t }}
  </h1>

  {% form 'customer_login' %}
    {{ form.errors | default_errors }}

    <div class="space-y-4">
      <input
        type="email"
        name="customer[email]"
        placeholder="{{ 'general.customer.login.email' | t }}"
        required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
      >
      <input
        type="password"
        name="customer[password]"
        placeholder="{{ 'general.customer.login.password' | t }}"
        required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
      >
      <button
        type="submit"
        class="w-full bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-8 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer"
      >
        {{ 'general.customer.login.submit' | t }}
      </button>
    </div>

    <div class="text-center mt-6 space-y-3">
      <a href="{{ routes.account_recover_url }}" class="font-mono text-xs text-[var(--color-mirloz-gold)] hover:text-[var(--color-mirloz-gold-light)] no-underline block">
        {{ 'general.customer.login.forgot_password' | t }}
      </a>
      <a href="{{ routes.account_register_url }}" class="font-mono text-xs text-[var(--color-mirloz-muted)] hover:text-[var(--color-mirloz-cream)] no-underline block">
        {{ 'general.customer.login.register_cta' | t }}
      </a>
    </div>
  {% endform %}

  {% if shop.checkout.guest_login %}
    <div class="text-center mt-6 pt-6 border-t border-[var(--color-mirloz-border)]">
      {% form 'guest_login' %}
        <button type="submit" class="font-mono text-xs text-[var(--color-mirloz-muted)] hover:text-[var(--color-mirloz-cream)] no-underline bg-transparent border-none cursor-pointer">
          {{ 'general.customer.login.guest_cta' | t }}
        </button>
      {% endform %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Iniciar Sesión",
  "settings": [],
  "presets": [
    {
      "name": "Login"
    }
  ]
}
{% endschema %}
