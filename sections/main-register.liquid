<section class="max-w-md mx-auto px-6 py-28">
  <h1 class="font-serif text-3xl md:text-4xl font-medium text-[var(--color-mirloz-cream)] mb-8 text-center">
    {{ 'general.customer.register.title' | t }}
  </h1>

  {% form 'create_customer' %}
    {{ form.errors | default_errors }}

    <div class="space-y-4">
      <input
        type="text"
        name="customer[first_name]"
        placeholder="{{ 'general.customer.register.first_name' | t }}"
        required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
      >
      <input
        type="text"
        name="customer[last_name]"
        placeholder="{{ 'general.customer.register.last_name' | t }}"
        required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
      >
      <input
        type="email"
        name="customer[email]"
        placeholder="{{ 'general.customer.register.email' | t }}"
        required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
      >
      <input
        type="password"
        name="customer[password]"
        placeholder="{{ 'general.customer.register.password' | t }}"
        required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
      >
      <button
        type="submit"
        class="w-full bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-8 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer"
      >
        {{ 'general.customer.register.submit' | t }}
      </button>
    </div>

    <div class="text-center mt-6">
      <a href="{{ routes.account_login_url }}" class="font-mono text-xs text-[var(--color-mirloz-muted)] hover:text-[var(--color-mirloz-cream)] no-underline">
        {{ 'general.customer.register.login_cta' | t }}
      </a>
    </div>
  {% endform %}
</section>

{% schema %}
{
  "name": "Registro",
  "settings": [],
  "presets": [
    {
      "name": "Registro"
    }
  ]
}
{% endschema %}
