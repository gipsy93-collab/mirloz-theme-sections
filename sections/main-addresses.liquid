<section class="max-w-3xl mx-auto px-6 py-28">
  <h1 class="font-serif text-3xl md:text-4xl font-medium text-[var(--color-mirloz-cream)] mb-8">
    {{ 'general.customer.addresses.title' | t }}
  </h1>

  <div class="mb-8">
    <button
      type="button"
      onclick="document.querySelector('.new-address-form').classList.toggle('hidden')"
      class="bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-6 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer"
    >
      + {{ 'general.customer.addresses.add' | t }}
    </button>
  </div>

  {% form 'customer_address', customer.new_address, class: 'new-address-form hidden mb-12' %}
    <div class="bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] rounded-lg p-6 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <input type="text" name="address[first_name]" placeholder="Nombre" required
          class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
        <input type="text" name="address[last_name]" placeholder="Apellido" required
          class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
        <input type="text" name="address[company]" placeholder="Empresa (opcional)"
          class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
        <input type="text" name="address[phone]" placeholder="Teléfono"
          class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
      </div>
      <input type="text" name="address[address1]" placeholder="Dirección" required
        class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
      <input type="text" name="address[address2]" placeholder="Apartamento, suite, etc. (opcional)"
        class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <input type="text" name="address[city]" placeholder="Ciudad" required
          class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
        <input type="text" name="address[zip]" placeholder="Código postal" required
          class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
        <select name="address[country]" class="w-full px-4 py-3 bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none">
          {{ all_country_option_tags }}
        </select>
      </div>
      <label class="flex items-center gap-2 text-sm text-[var(--color-mirloz-muted)] font-sans cursor-pointer">
        <input type="checkbox" name="address[default]" value="1">
        {{ 'general.customer.addresses.default' | t }}
      </label>
      <button type="submit" class="bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-6 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer">
        Guardar dirección
      </button>
    </div>
  {% endform %}

  {% if customer.addresses_count > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for address in customer.addresses %}
        <div class="bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] rounded-lg p-6 relative">
          {% if address == customer.default_address %}
            <span class="absolute top-4 right-4 font-mono text-[9px] text-[var(--color-mirloz-gold)] border border-[var(--color-mirloz-gold)]/20 px-2 py-0.5">
              {{ 'general.customer.addresses.default' | t }}
            </span>
          {% endif %}
          <p class="text-sm text-[var(--color-mirloz-cream)] font-sans leading-relaxed">
            {{ address | format_address }}
          </p>
          <div class="flex gap-3 mt-4 pt-4 border-t border-[var(--color-mirloz-border)]">
            <button
              type="button"
              onclick="document.querySelector('#edit-address-{{ address.id }}').classList.toggle('hidden')"
              class="font-mono text-[10px] text-[var(--color-mirloz-gold)] hover:text-[var(--color-mirloz-gold-light)] bg-transparent border-none cursor-pointer"
            >
              {{ 'general.customer.addresses.edit' | t }}
            </button>
            <button
              type="button"
              data-address-delete="{{ address.id }}"
              class="font-mono text-[10px] text-[var(--color-mirloz-muted)] hover:text-red-400 bg-transparent border-none cursor-pointer"
            >
              {{ 'general.customer.addresses.delete' | t }}
            </button>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="text-[var(--color-mirloz-muted)] font-sans text-sm">
      {{ 'general.customer.addresses.no_addresses' | t }}
    </p>
  {% endif %}

  <div class="mt-8">
    <a href="{{ routes.account_url }}" class="font-mono text-xs text-[var(--color-mirloz-gold)] hover:text-[var(--color-mirloz-gold-light)] no-underline">
      &larr; {{ 'general.customer.account.title' | t }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Direcciones",
  "settings": [],
  "presets": [
    {
      "name": "Direcciones"
    }
  ]
}
{% endschema %}
