<section class="max-w-6xl mx-auto px-6 py-28">
  <h1 class="font-serif text-4xl md:text-5xl font-medium text-[var(--color-mirloz-cream)] mb-4">
    {{ blog.title }}
  </h1>
  <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-mirloz-gold)] mb-12">
    {{ blog.articles_count }} {{ blog.articles_count | pluralize: 'artículo', 'artículos' }}
  </p>

  {% if blog.articles_count > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for article in blog.articles %}
        <article class="group bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] hover:border-[var(--color-mirloz-gold)]/40 rounded-lg overflow-hidden transition-all duration-300 flex flex-col">
          <div class="aspect-video bg-black/20 overflow-hidden border-b border-[var(--color-mirloz-border)]">
            {% if article.image %}
              <img
                src="{{ article.image.src | image_url: width: 600 }}"
                alt="{{ article.title }}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              >
            {% endif %}
          </div>
          <div class="p-6 flex flex-col flex-1">
            <span class="font-mono text-[9px] text-[var(--color-mirloz-muted)] mb-2">
              {{ article.published_at | date: "%d %b %Y" }}
            </span>
            <h3 class="font-serif text-xl text-[var(--color-mirloz-cream)] group-hover:text-[var(--color-mirloz-gold)] transition-colors mb-2">
              <a href="{{ article.url }}" class="no-underline text-inherit">{{ article.title }}</a>
            </h3>
            <p class="text-sm text-[var(--color-mirloz-muted)] leading-relaxed font-sans flex-1">
              {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
            </p>
            <a href="{{ article.url }}" class="inline-flex items-center gap-1 font-mono text-xs text-[var(--color-mirloz-gold)] hover:text-[var(--color-mirloz-gold-light)] transition-colors no-underline mt-4">
              {{ 'general.blog.read_more' | t }}
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="text-center py-20">
      <p class="font-mono text-sm text-[var(--color-mirloz-muted)]">
        {{ 'general.blog.no_articles' | t }}
      </p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [],
  "presets": [
    {
      "name": "Blog Principal"
    }
  ]
}
{% endschema %}
