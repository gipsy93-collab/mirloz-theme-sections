<section id="StorySection-{{ section.id }}" class="w-full py-24 relative z-10 bg-[var(--color-mirloz-surface)] border-t border-[var(--color-mirloz-border)]">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Upper Part - The Family Name -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-20">
      <!-- Left - Image -->
      <div class="relative">
        <div class="absolute w-[80%] h-[80%] bg-[var(--color-mirloz-gold)]/10 rounded-full blur-[100px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>

        <div class="relative aspect-[4/3] border border-[var(--color-mirloz-border)] overflow-hidden max-w-md mx-auto rounded-lg">
          {% if section.settings.story_image != blank %}
            <img
              src="{{ section.settings.story_image | image_url: width: 600 }}"
              alt="{{ section.settings.story_image_alt | default: 'Mirloz Origen' }}"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?auto=format&fit=crop&q=80&w=600&h=450"
              alt="Café de Especialidad - Mirloz"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          {% endif %}
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-mirloz-dark)]/90 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <p class="font-serif text-xl text-[var(--color-mirloz-cream)]">{{ section.settings.image_title }}</p>
            <p class="font-mono text-[10px] text-[var(--color-mirloz-gold)] uppercase tracking-wider">{{ section.settings.image_subtitle }}</p>
          </div>
        </div>
      </div>

      <!-- Right - Family Story -->
      <div class="space-y-6">
        <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-mirloz-gold)]">
          {{ section.settings.badge_text }}
        </p>
        <h2 class="font-serif text-4xl md:text-5xl font-medium text-[var(--color-mirloz-cream)] leading-[1.1]">
          {{ section.settings.heading }}
        </h2>
        <div class="text-[var(--color-mirloz-muted)] leading-relaxed text-base font-sans space-y-4">
          {{ section.settings.story_richtext }}
        </div>
      </div>
    </div>

    <!-- Lower Part - The Mirlo Metaphor Grid -->
    <div class="border-t border-[var(--color-mirloz-border)]/60 pt-16">
      <div class="text-center mb-12">
        <h3 class="font-serif text-3xl text-[var(--color-mirloz-cream)]">{{ section.settings.metaphor_heading }}</h3>
        <p class="text-sm text-[var(--color-mirloz-muted)] mt-2 font-sans">{{ section.settings.metaphor_subheading }}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Metaphor 1 -->
        <div class="bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] p-8 rounded-lg hover:border-[var(--color-mirloz-gold)]/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-full bg-[var(--color-mirloz-gold)]/10 flex items-center justify-center mb-6 text-[var(--color-mirloz-gold)] text-xl font-bold">
            {{ section.settings.card_1_icon }}
          </div>
          <h4 class="font-serif text-xl text-[var(--color-mirloz-cream)] mb-3">{{ section.settings.card_1_title }}</h4>
          <p class="text-sm text-[var(--color-mirloz-muted)] leading-relaxed font-sans">
            {{ section.settings.card_1_desc }}
          </p>
        </div>

        <!-- Metaphor 2 -->
        <div class="bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] p-8 rounded-lg hover:border-[var(--color-mirloz-gold)]/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-full bg-[var(--color-mirloz-gold)]/10 flex items-center justify-center mb-6 text-[var(--color-mirloz-gold)] text-xl font-bold">
            {{ section.settings.card_2_icon }}
          </div>
          <h4 class="font-serif text-xl text-[var(--color-mirloz-cream)] mb-3">{{ section.settings.card_2_title }}</h4>
          <p class="text-sm text-[var(--color-mirloz-muted)] leading-relaxed font-sans">
            {{ section.settings.card_2_desc }}
          </p>
        </div>

        <!-- Metaphor 3 -->
        <div class="bg-[var(--color-mirloz-dark)] border border-[var(--color-mirloz-border)] p-8 rounded-lg hover:border-[var(--color-mirloz-gold)]/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-full bg-[var(--color-mirloz-gold)]/10 flex items-center justify-center mb-6 text-[var(--color-mirloz-gold)] text-xl font-bold">
            {{ section.settings.card_3_icon }}
          </div>
          <h4 class="font-serif text-xl text-[var(--color-mirloz-cream)] mb-3">{{ section.settings.card_3_title }}</h4>
          <p class="text-sm text-[var(--color-mirloz-muted)] leading-relaxed font-sans">
            {{ section.settings.card_3_desc }}
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Mirloz Story",
  "settings": [
    {
      "type": "header",
      "content": "Historia Familiar"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Nuestra Esencia"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Un homenaje familiar hecho café y ciencia."
    },
    {
      "type": "richtext",
      "id": "story_richtext",
      "label": "Story Rich Text",
      "default": "<p>El nombre <strong>Mirloz</strong> nace de la unión de dos pilares esenciales: el nombre de mi madre, <strong>Mirian</strong>, y el apellido de mi padre, <strong>López</strong>. Es un tributo a nuestras raíces, al amor por la tierra y al esfuerzo de nuestra herencia.</p><p>Pero el nombre también juega con el <strong>Mirlo</strong>, esa ave audaz y curiosa del bosque. Decidimos llevar este paralelismo a cada aspecto de nuestro café de especialidad, convirtiendo la taza en una experiencia tan profunda y libre como el vuelo del ave.</p>"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story Image"
    },
    {
      "type": "text",
      "id": "image_title",
      "label": "Image Label Title",
      "default": "El Vuelo de Nuestras Raíces"
    },
    {
      "type": "text",
      "id": "image_subtitle",
      "label": "Image Label Subtitle",
      "default": "Mirian + López = Mirloz"
    },
    {
      "type": "header",
      "content": "Tarjetas de la Metáfora"
    },
    {
      "type": "text",
      "id": "metaphor_heading",
      "label": "Metaphors Heading",
      "default": "La Metáfora del Mirlo"
    },
    {
      "type": "text",
      "id": "metaphor_subheading",
      "label": "Metaphors Subheading",
      "default": "¿Cómo se traduce el ave en cada sorbo de Café Mirloz?"
    },
    {
      "type": "header",
      "content": "Tarjeta Metáfora 1: Plumaje"
    },
    {
      "type": "text",
      "id": "card_1_icon",
      "label": "Card 1 Icon (Emoji/Char)",
      "default": "✨"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Card 1 Title",
      "default": "Plumaje y Pico de Fuego"
    },
    {
      "type": "textarea",
      "id": "card_1_desc",
      "label": "Card 1 Description",
      "default": "El mirlo macho destaca por su plumaje negro profundo y su pico amarillo-naranja brillante. Nuestro café imita este contraste: una bolsa de diseño negro mate y misterioso, que al abrirse revela un pico de luz dorada: un fanzine científico vibrante."
    },
    {
      "type": "header",
      "content": "Tarjeta Metáfora 2: Canto"
    },
    {
      "type": "text",
      "id": "card_2_icon",
      "label": "Card 2 Icon (Emoji/Char)",
      "default": "🎵"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Card 2 Title",
      "default": "El Canto de la Taza"
    },
    {
      "type": "textarea",
      "id": "card_2_desc",
      "label": "Card 2 Description",
      "default": "El canto del mirlo es melódico, complejo e improvisado, adaptándose al amanecer y atardecer. Así es el perfil de nuestro café: notas frutales y achocolatadas que cambian y deleitan al paladar, ofreciendo una sinfonía única en cada taza."
    },
    {
      "type": "header",
      "content": "Tarjeta Metáfora 3: Curiosidad"
    },
    {
      "type": "text",
      "id": "card_3_icon",
      "label": "Card 3 Icon (Emoji/Char)",
      "default": "🔍"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Card 3 Title",
      "default": "Curiosidad Terrenal"
    },
    {
      "type": "textarea",
      "id": "card_3_desc",
      "label": "Card 3 Description",
      "default": "El mirlo es inteligente y curioso, escarbando las hojas secas del suelo para encontrar alimento. Nuestro proyecto emula esa búsqueda incansable del conocimiento, investigando y divulgando ciencia en un fanzine físico exclusivo de regalo."
    }
  ],
  "presets": [
    {
      "name": "Mirloz Story",
      "category": "Text"
    }
  ]
}
{% endschema %}
