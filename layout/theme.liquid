<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2B0D10">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ page_title }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Mirloz Compiled Tailwind CSS -->
    {{ 'mirloz-styles.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="bg-[var(--color-mirloz-dark)] text-[var(--color-mirloz-cream)] min-h-screen font-sans selection:bg-[var(--color-mirloz-gold)] selection:text-[var(--color-mirloz-dark)]">
    {% section 'mirloz-header' %}
    <main id="MainContent" class="focus:none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
