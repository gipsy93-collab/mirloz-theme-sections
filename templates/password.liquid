<div class="min-h-screen flex items-center justify-center bg-[var(--color-mirloz-dark)]">
  <div class="max-w-md mx-auto px-6 py-32 text-center">
    <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-mirloz-gold)] mb-6">MIRLOZ</p>
    <h1 class="font-serif text-3xl md:text-5xl font-medium text-[var(--color-mirloz-cream)] mb-6">
      {{ 'general.password.title' | t }}
    </h1>
    <p class="text-[var(--color-mirloz-muted)] text-base mb-10 font-sans leading-relaxed">
      {{ 'general.password.subtext' | t }}
    </p>

    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="flex flex-col gap-4">
        <input
          type="password"
          name="password"
          placeholder="{{ 'general.password.placeholder' | t }}"
          class="w-full px-5 py-3 bg-[var(--color-mirloz-surface)] border border-[var(--color-mirloz-border)] text-[var(--color-mirloz-cream)] font-sans text-sm focus:border-[var(--color-mirloz-gold)] focus:outline-none"
        >
        <button
          type="submit"
          class="w-full bg-[var(--color-mirloz-gold)] hover:bg-[var(--color-mirloz-gold-light)] text-[var(--color-mirloz-dark)] font-bold px-8 py-3 transition-all font-mono text-xs tracking-[0.15em] uppercase cursor-pointer"
        >
          {{ 'general.password.button' | t }}
        </button>
      </div>
    {% endform %}
  </div>
</div>
